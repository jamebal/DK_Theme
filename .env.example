VITE_APP_NAME=Moss
VITE_API_BASE_URL=/
VITE_ENABLE_MOCK=false

# Optional authenticated endpoint; never put Apple IDs or passwords in VITE_* variables.
VITE_APP_ACCOUNTS_API_PATH=

VITE_NODE_STATUS_API_PATH=/api/v1/user/server/fetch
VITE_NODE_STATUS_REFRESH_INTERVAL_MS=60000

# Development proxy upstream origin, e.g. https://komari.example.com
# Leave empty to disable the development proxy; restart Vite after changing it.
KOMARI_HOST=

# Browser-facing same-origin RPC path
VITE_KOMARI_API_URL=/api/komari/rpc2

# Optional: derive ws/wss from VITE_KOMARI_API_URL when empty
VITE_KOMARI_WS_URL=
